{
  "name": "aiedcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:static": "node scripts/generate-detail-pages.mjs && node scripts/build-static-site.mjs",
    "generate:pages": "node scripts/generate-detail-pages.mjs",
    "check:links": "node scripts/check-links.mjs",
